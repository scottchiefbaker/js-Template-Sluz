{
  "name": "template-sluz",
  "version": "0.9.7",
  "description": "A minimalistic JavaScript templating engine with Smarty-like syntax",
  "type": "module",
  "main": "./src/sluz.js",
  "exports": {
    ".": "./src/sluz.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "version:sync": "node scripts/sync-version.js",
    "prebuild": "node scripts/sync-version.js",
    "prebuild:esm": "node scripts/sync-version.js",
    "prebuild:global": "node scripts/sync-version.js",
    "prepublishOnly": "node scripts/sync-version.js",
    "build": "V=$(node -p \"JSON.parse(require('fs').readFileSync('./package.json','utf8')).version\") && esbuild src/sluz.js --minify --format=esm --outfile=src/sluz.min.js --banner:js=\"/* template-sluz v$V (ESM) */\" && esbuild src/sluz.global.js --bundle --minify --format=iife --outfile=src/sluz.global.min.js --banner:js=\"/* template-sluz v$V (global) */\"",
    "build:esm": "V=$(node -p \"JSON.parse(require('fs').readFileSync('./package.json','utf8')).version\") && esbuild src/sluz.js --minify --format=esm --outfile=src/sluz.min.js --banner:js=\"/* template-sluz v$V (ESM) */\"",
    "build:global": "V=$(node -p \"JSON.parse(require('fs').readFileSync('./package.json','utf8')).version\") && esbuild src/sluz.global.js --bundle --minify --format=iife --outfile=src/sluz.global.min.js --banner:js=\"/* template-sluz v$V (global) */\""
  },
  "files": [
    "src"
  ],
  "unpkg": "src/sluz.global.min.js",
  "jsdelivr": "src/sluz.global.min.js",
  "keywords": [
    "template",
    "smarty",
    "templating",
    "sluz"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
